Package: gdtools
Title: Font Metrics and Font Management Utilities for R Graphics
Version: 0.5.3
Authors@R: c(
    person("David", "Gohel", , "david.gohel@ardata.fr", role = c("aut", "cre")),
    person("Hadley", "Wickham", , "hadley@rstudio.com", role = "aut"),
